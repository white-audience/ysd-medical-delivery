# 复制为 .env 后按需修改：cp .env.example .env
# docker compose 会自动读取项目根目录下的 .env
# 所有值均为占位符；请勿把真实密钥提交到仓库。

# ---------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me

# ---------------------------------------------------------------
# Nacos 3.x 鉴权
# ---------------------------------------------------------------
# NACOS_AUTH_TOKEN 必须是 Base64，解码后 >= 32 字节
# 生成方式：openssl rand -base64 32
NACOS_AUTH_TOKEN=replace-with-base64-random-32-bytes
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=security
NACOS_ADMIN_PASSWORD=change-me
NACOS_USERNAME=nacos
NACOS_PASSWORD=change-me

# ---------------------------------------------------------------
# Redis
# ---------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# 业务缓存 db10；AI RAG 使用 db0
REDIS_DATABASE=10

# ---------------------------------------------------------------
# RabbitMQ
# ---------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=change-me

# ---------------------------------------------------------------
# JWT：网关与所有服务必须使用同一组密钥
# 生成方式：openssl rand -base64 48
# ---------------------------------------------------------------
JWT_ADMIN_SECRET=replace-with-random-secret
JWT_USER_SECRET=replace-with-random-secret

# ---------------------------------------------------------------
# 微信小程序（服务端）
# ---------------------------------------------------------------
WECHAT_APPID=
WECHAT_APPSECRET=
# 支付回调基地址（本地开发可填 http://localhost:8085）
NOTIFY_BASE_URL=http://localhost:8085

# ---------------------------------------------------------------
# 阿里云 OSS
# ---------------------------------------------------------------
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=

# ---------------------------------------------------------------
# AI
# ---------------------------------------------------------------
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:18434

# ---------------------------------------------------------------
# 镜像加速（可选）
# ---------------------------------------------------------------
# MAVEN_IMAGE=docker.1ms.run/library/maven:3.9-eclipse-temurin-21
# JRE_IMAGE=docker.1ms.run/library/eclipse-temurin:21-jre
# REDIS_IMAGE=docker.1ms.run/redis/redis-stack-server:latest

# ---------------------------------------------------------------
# 宿主机 Ollama 前置条件（不在 compose 中启动）：
#   1. 让 Ollama 监听所有网卡，而不是只监听 127.0.0.1：
#        Windows:  setx OLLAMA_HOST 0.0.0.0:18434   （设置后重启 Ollama）
#        Linux:    OLLAMA_HOST=0.0.0.0:18434 ollama serve
#   2. 拉取 AI 服务使用的向量模型：
#        ollama pull bge-m3
# ---------------------------------------------------------------
